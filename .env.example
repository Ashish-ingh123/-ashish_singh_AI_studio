# Copy this file to .env.local and put the real values there. .env.local is never committed.

# The Google Gemini API key for "Ask about Ashvanta". Create one in Google AI Studio. Server only.
GEMINI_API_KEY=your-key-here

# Optional: the Gemini model to use. Leave empty for the default set in src/app/api/ask/route.ts.
GEMINI_MODEL=

# The Resend API key for the "Request a demo" form. Create one at resend.com with
# the permission "Sending access". Server only.
RESEND_API_KEY=your-key-here

# The address that receives the form's emails. Without a verified domain, Resend delivers
# only to the address the Resend account was registered with. Server only; never commit it.
CONTACT_TO_EMAIL=you@example.com

# Optional: the sender, once a domain is verified in Resend, for example
# "Website <forms@your-domain>". Leave empty for Resend's shared sender, set in
# src/app/api/contact/route.ts.
CONTACT_FROM_EMAIL=
